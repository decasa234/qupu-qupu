DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qupu
# JWT_SECRET: REQUIRED. In production it must be unique and >= 32 chars, or the
# server refuses to start. Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=change-me
PORT=3001
# APP_ORIGIN: comma-separated origin allowlist. REQUIRED in production (the
# server refuses to start without it and will not reflect arbitrary origins).
APP_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001/api
# VITE_ADMIN_ONLY: set to 'true' ONLY on the admin deployment (e.g. the
# admin.qupu.id Vercel project) to lock every route behind an admin login.
# Cosmetic gate — real authorization stays server-side. Leave unset for
# production and local dev.
VITE_ADMIN_ONLY=

# Postgres pool (serverless tuning). Keep `max` small per instance and lean on
# a pooler for scale. SSL is opt-in: `verify` (preferred, full cert check),
# `require` (TLS without verification), or unset for local non-TLS.
PG_POOL_MAX=5
DATABASE_SSL=

# CRON_SECRET: shared secret for the Vercel Cron jobs (GET /api/cron/cleanup
# and GET /api/cron/notifications). Vercel sends it as
# `Authorization: Bearer <secret>`.
CRON_SECRET=

# Resend (transactional email — used for OTP register and the parent
# notification loop: streak-at-risk reminders + Monday weekly digest)
RESEND_API_KEY=
RESEND_FROM=noreply@example.com

# Parent notification channel: 'email' (default, Resend) or 'whatsapp'
# (future — Fonnte-shaped stub; requires the WHATSAPP_* envs below).
NOTIFICATION_CHANNEL=email
# Optional/future: only needed when NOTIFICATION_CHANNEL=whatsapp.
# WHATSAPP_TOKEN=
# WHATSAPP_SENDER=

# YouTube Data API v3 — used by the single-video importer and the
# admin channel-listing/bulk-import picker.
YOUTUBE_API_KEY=
# Channel handle whose uploads are listed in the picker; must match
# /^@[A-Za-z0-9_.-]{1,50}$/. Defaults to @qupuid when unset.
YOUTUBE_CHANNEL_HANDLE=@qupuid
# Optional: skip the channels.list?forHandle=... resolution call by
# providing the uploads playlist ID directly. Recommended on Vercel
# serverless to avoid an extra API call on each cold start.
YOUTUBE_UPLOADS_PLAYLIST_ID=
